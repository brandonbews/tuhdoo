{
  "name": "tuhdoo-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/check-no-js.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "astro": "7.3.5",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.14",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.0",
    "typescript": "6.0.3"
  }
}
